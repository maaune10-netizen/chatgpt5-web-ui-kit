{
  "name": "gpt5-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "suite": "node tools/prompt-suite.mjs",
    "suite:genui": "node tools/prompt-suite.mjs --genui --max-tokens 16384",
    "genui:prompt": "node tools/openui-prompt.mjs",
    "openui:inspect": "node tools/openui-inspect.mjs",
    "openui:eval": "node tools/openui-eval.mjs --effort auto --fix-rules",
    "openui:loop": "node tools/loop-probe.mjs",
    "links": "node tools/links.mjs"
  },
  "dependencies": {
    "@openuidev/react-lang": "^1.0.1",
    "@openuidev/react-ui": "^0.18.1",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
